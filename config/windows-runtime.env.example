# Copy only the required values into:
# %LOCALAPPDATA%\ArtemControlCenter\runtime.env
#
# The installer creates a safe local file automatically and never overwrites it.
# It removes inherited ACLs and grants access only to the panel Windows account
# and SYSTEM. Do not commit the real local file or any token/key.
# Frontend rollout is not configured here. Installer and updater always build
# the source-controlled accepted-v2 profile via npm run build:production.

# fixtures is used for the first production-runtime hardware acceptance.
# configure-home-production.ps1 changes this only after private HA/Alice checks pass.
PANEL_AGENT_MODE=fixtures

# Fixture mutations are development-only. Keep false in the Windows production
# runtime so a simulated state can never be shown as physical confirmation.
PANEL_FIXTURE_WRITES_ENABLED=false

# Deployment-level maximum write permissions. The production configurator keeps
# these false during verification and enables the coffee gates only after HA
# REST/WebSocket and AliceTG readiness are confirmed.
PANEL_WRITES_ENABLED=false
PANEL_OVERVIEW_LAYOUT_WRITES_ENABLED=false
PANEL_OVERVIEW_LAYOUT_PATH=.cache/overview-layout.json
PANEL_CALENDAR_DISPLAY_COLOR_WRITES_ENABLED=false
# The production runtime defaults this to %LOCALAPPDATA%\ArtemControlCenter\calendar-display-colors.json.
# PANEL_CALENDAR_DISPLAY_COLOR_PATH=
PANEL_COFFEE_TIMING_WRITES_ENABLED=false
PANEL_COFFEE_NOTIFICATION_WRITES_ENABLED=false
PANEL_COFFEE_ACTIONS_ENABLED=false

# Optional fixed ASUS ROG G703GI integration. Keep disabled until the local
# companion is installed on the ASUS and the values are entered locally.
# PANEL_ROG_G703_ENABLED=false
# PANEL_ROG_G703_TARGET_ID=rog_g703gi
# PANEL_ROG_G703_MAC=AA:BB:CC:DD:EE:FF
# PANEL_ROG_G703_BROADCAST_ADDRESS=255.255.255.255
# PANEL_ROG_G703_BROADCAST_INTERFACE=192.168.1.10
# PANEL_ROG_G703_COMPANION_BASE_URL=http://192.168.1.25:8769
# PANEL_ROG_G703_COMPANION_SECRET=
# PANEL_ROG_G703_WOL_REPEATS=3
# PANEL_ROG_G703_WOL_COOLDOWN_SECONDS=5
# PANEL_ROG_G703_SLEEP_COOLDOWN_SECONDS=10
# PANEL_ROG_G703_HIBERNATE_COOLDOWN_SECONDS=10
# PANEL_ROG_G703_HEALTH_TIMEOUT_SECONDS=60
# PANEL_ROG_G703_SLEEP_TIMEOUT_SECONDS=45
# PANEL_ROG_G703_HIBERNATE_TIMEOUT_SECONDS=45

# Private production integrations. Tokens are entered interactively and never
# committed. The URLs below are local SSH forwards, not public endpoints.
# PANEL_HA_URL=http://127.0.0.1:18123
# PANEL_HA_TOKEN=
# PANEL_HA_STALE_AFTER_SECONDS=90
# PANEL_STATE_CACHE_PATH=%LOCALAPPDATA%\ArtemControlCenter\panel-state-cache.json
# PANEL_ALICE_HEALTH_URL=http://127.0.0.1:18088
# PANEL_ALICE_DETAILS_TOKEN=
# PANEL_ALICE_BASE_URL=http://127.0.0.1:18088
# PANEL_ALICE_CONTROL_CENTER_TOKEN=

# Planning uses the same private Alice origin and the existing A4 panel-agent
# audience. configure-home-production.ps1 verifies authenticated
# /internal/planning/v1/status before enabling this integration. The internal
# secret is AliceTG INTERNAL_WEBHOOK_SECRET; the panel secret is independent.
# Never copy real values into this example or Git.
# PANEL_PLANNING_ENABLED=false
# PANEL_PLANNING_BASE_URL=http://127.0.0.1:18088
# PANEL_PLANNING_INTERNAL_SECRET=
# PANEL_PLANNING_SECRET=
# PANEL_PLANNING_REMINDER_MUTATIONS_ENABLED=false
# PANEL_PLANNING_TASK_MUTATIONS_ENABLED=false
# PANEL_PLANNING_CALENDAR_MUTATIONS_ENABLED=false

# AVALAR public health and restricted SSH details/actions are configured by the
# separate idempotent AVALAR rollout helper.
# PANEL_AVALAR_MAIN_URL=https://avalar.pro
# PANEL_AVALAR_STAGE_URL=https://stage.avalar.pro
# PANEL_AVALAR_SSH_ENABLED=false
# PANEL_AVALAR_SSH_HOST=avalar-status
# PANEL_AVALAR_SSH_STATUS_COMMAND=control-center
# PANEL_AVALAR_ACTIONS_ENABLED=false
# PANEL_AVALAR_ACTION_SSH_HOST=avalar-control
# PANEL_AVALAR_ACTION_COMMAND=control-center
