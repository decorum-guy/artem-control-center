{
  "name": "artem-control-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/dashboard",
    "packages/contracts",
    "packages/config"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs read_only",
    "dev:fixtures": "node scripts/dev.mjs fixtures",
    "dev:read-only": "node scripts/dev.mjs read_only",
    "dev:mac": "node scripts/dev.mjs fixtures --open",
    "start:production": "node scripts/production-runtime.mjs",
    "build": "npm run build --workspace @artem/dashboard",
    "lint": "npm run lint --workspace @artem/dashboard",
    "typecheck": "npm run typecheck --workspace @artem/dashboard",
    "test:unit": "npm run test --workspace @artem/dashboard",
    "test:python": "node scripts/python.mjs -m pytest apps/panel-agent/tests",
    "test:runtime": "node --test scripts/tests/production-runtime.test.mjs",
    "test:production-smoke": "node scripts/production-smoke.mjs",
    "test": "npm run lint && npm run typecheck && npm run test:unit && npm run test:python && npm run test:runtime",
    "test:e2e": "node scripts/playwright.mjs test",
    "test:visual": "node scripts/playwright.mjs test --grep @visual",
    "visual:review": "node scripts/visual-review.mjs",
    "install:browsers": "npx playwright install chromium",
    "check": "npm run test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
